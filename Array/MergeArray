#include<iostream>
#include<vector>
using namespace std;

vector<int > MergeSortedArray(int arr1[], int arr2[],int n, int m){

    int i = 0;
    int j = 0;
    int k = 0;

    vector<int> arr3;
    while(i<n &&  j < m) {

        if(arr1[i] < arr2[j]){
            arr3.push_back(arr1[i]);
            i++;
        }

        else {
            arr3.push_back(arr2[j]);
            j++;
            k++;
        }
    }

    while(i < n){
        arr3.push_back(arr1[i]);
        i++;
    }

    while(j <m ){
        arr3.push_back(arr2[j]);
        j++;
    }
    return arr3;
}

int main(){
 int n;
    cout << "Enter array elements: ";
    cin >> n;

    int arr1[100];

    cout << "Enter array 1: ";
    for(int i = 0; i < n; i++){
        cin >> arr1[i];
    }

    int m;
    cout << "Enter array elements: ";
    cin >> m;

    int arr2[100];

    cout << "Enter array 2: ";
    for(int i = 0; i < m; i++){
        cin >> arr2[i];
    }


    vector<int> ans = MergeSortedArray(arr1, arr2, n, m);

    cout << "Merged Array: ";

    for(int i=0; i<n+m; i++){
        cout << ans[i] << " ";
    }
    

    return 0;
}
